  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Collectible
  tipo: 1
  cargaBateria: 30
  textoProntuario: "KARLHEINZ ASYLUM \u2014 PRONTU\xC1RIO N\xBA 5\n29/08/1974\n\nAnota\xE7\xE3o do Dr. Vogel:\n\n\"Ele n\xE3o \xE9 mais Emil. O que eu criei n\xE3o pode sair deste pr\xE9dio. Tranquei todos aqui dentro comigo.\n\nSe algu\xE9m encontrar estes registros: n\xE3o corra em linha reta, n\xE3o deixe a luz acesa por muito tempo. Ele sente o seu cheiro.\"\n\n[ESC] Fechar"
